# Один домен на всё: API и шлюз Feather, сигнализация LiveKit.
# Caddy сам получает и продлевает сертификат Let's Encrypt.
{$DOMAIN} {
	encode zstd gzip

	# Сигнализация LiveKit (WebSocket /rtc и API /twirp)
	@livekit path /rtc* /twirp*
	handle @livekit {
		reverse_proxy host.docker.internal:7880
	}

	handle {
		reverse_proxy server:8080
	}
}
