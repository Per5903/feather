// Клиент Feather на Slint. Правила лёгкости (docs/02-performance.md):
// никаких тяжёлых эффектов, анимации только простые, списки виртуализированы.

import { ListView, LineEdit, Button } from "std-widgets.slint";

export struct Msg {
    head: bool,
    author: string,
    initial: string,
    tint: color,
    time: string,
    text: string,
    edited: bool,
    has-image: bool,
    img-w: length,
    img-h: length,
    img-label: string,
    img-tint: color,
}

export struct Member {
    name: string,
    initial: string,
    tint: color,
}

export struct GuildItem {
    name: string,
    initial: string,
    active: bool,
    unread: bool,
}

export enum ChannelKind { text, voice, category }

export struct ChannelItem {
    name: string,
    kind: ChannelKind,
    active: bool,
    unread: bool,
}

global Theme {
    out property <color> bg0: #111214;
    out property <color> bg1: #1a1b1e;
    out property <color> bg2: #222327;
    out property <color> hover: #2b2d31;
    out property <color> active: #34363c;
    out property <color> row-hover: #26272b;
    out property <color> text: #dcdee1;
    out property <color> dim: #8e9297;
    out property <color> accent: #6c8cff;
    out property <color> border: #2a2b2f;
    out property <color> danger: #f07178;
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: tint;
    Text {
        width: parent.width;
        height: parent.height;
        text: initial;
        color: #111;
        font-weight: 700;
        font-size: size * 0.38;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Icon inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: ita.has-hover ? Theme.hover : transparent;
    ita := TouchArea { clicked => { root.clicked(); } }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: icon;
        fill: ita.has-hover ? Theme.text : Theme.dim;
    }
}

component MessageRow inherits Rectangle {
    in property <Msg> m;
    background: ta.has-hover ? Theme.row-hover : transparent;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: m.head ? 14px : 2px;
        padding-bottom: 2px;
        spacing: 16px;
        VerticalLayout {
            alignment: start;
            width: 40px;
            if m.head: Avatar {
                initial: m.initial;
                tint: m.tint;
            }
            if !m.head: Text {
                height: 22px;
                text: ta.has-hover ? m.time : "";
                color: Theme.dim;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 2px;
            if m.head: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: m.author;
                    color: m.tint;
                    font-weight: 600;
                }
                Text {
                    text: m.time;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: bottom;
                }
            }
            Text {
                text: m.edited ? m.text + "  (изменено)" : m.text;
                color: Theme.text;
                wrap: word-wrap;
            }
            if m.has-image: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Rectangle {
                    width: m.img-w;
                    height: m.img-h;
                    border-radius: 8px;
                    background: m.img-tint;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: m.img-label;
                        color: #0000008c;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component ChannelRow inherits Rectangle {
    in property <ChannelItem> c;
    callback clicked();
    property <bool> lit: c.active || c.unread || cta.has-hover;
    height: c.kind == ChannelKind.category ? 30px : 32px;
    border-radius: 4px;
    background: c.kind == ChannelKind.category ? transparent : c.active ? Theme.active : cta.has-hover ? Theme.hover : transparent;
    cta := TouchArea { clicked => { root.clicked(); } }
    // Метка непрочитанного слева, как в Discord
    if c.unread && !c.active: Rectangle {
        x: -8px;
        y: (parent.height - self.height) / 2;
        width: 4px;
        height: 8px;
        border-radius: 2px;
        background: Theme.text;
    }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;
        if c.kind == ChannelKind.voice: VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: "M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4z";
                fill: lit ? Theme.text : Theme.dim;
            }
        }
        Text {
            text: c.kind == ChannelKind.text ? "# " + c.name : c.name;
            color: c.kind == ChannelKind.category ? Theme.dim : lit ? Theme.text : Theme.dim;
            font-size: c.kind == ChannelKind.category ? 12px : 15px;
            font-weight: c.kind == ChannelKind.category || c.unread ? 600 : 400;
            vertical-alignment: c.kind == ChannelKind.category ? bottom : center;
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text {
        text: label;
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
    }
    @children
}

component LoginScreen inherits Rectangle {
    in-out property <string> server-url;
    in-out property <string> username;
    in-out property <string> password;
    in property <string> error;
    in property <bool> busy;
    callback login();
    callback register();
    background: Theme.bg0;
    Rectangle {
        width: 400px;
        height: form.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 12px;
        form := VerticalLayout {
            padding: 28px;
            spacing: 14px;
            Text {
                text: "Feather";
                font-size: 26px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Вход на сервер сообщества";
                color: Theme.dim;
                horizontal-alignment: center;
            }
            Field {
                label: "АДРЕС СЕРВЕРА";
                LineEdit { text <=> root.server-url; enabled: !busy; }
            }
            Field {
                label: "ИМЯ";
                LineEdit { text <=> root.username; enabled: !busy; }
            }
            Field {
                label: "ПАРОЛЬ";
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    enabled: !busy;
                    accepted => { root.login(); }
                }
            }
            if error != "": Text {
                text: error;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: busy ? "Подключаюсь…" : "Войти";
                    primary: true;
                    enabled: !busy;
                    clicked => { root.login(); }
                }
                Button {
                    text: "Регистрация";
                    enabled: !busy;
                    clicked => { root.register(); }
                }
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> ok-text;
    in property <bool> read-only;
    in-out property <string> value;
    callback ok();
    callback cancel();
    background: #000000a8;
    // Перехватываем клики, чтобы они не уходили в окно под диалогом
    TouchArea { }
    Rectangle {
        width: 420px;
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 10px;
        box := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            if hint != "": Text {
                text: hint;
                color: Theme.dim;
                wrap: word-wrap;
            }
            LineEdit {
                text <=> root.value;
                read-only: root.read-only;
                accepted => { root.ok(); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: ok-text == "" ? "Закрыть" : "Отмена";
                    clicked => { root.cancel(); }
                }
                if ok-text != "": Button {
                    text: ok-text;
                    primary: true;
                    clicked => { root.ok(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Feather";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.bg0;
    default-font-size: 15px;

    // ---- вход
    in property <bool> logged-in;
    in-out property <string> server-url;
    in-out property <string> login-name;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    callback login();
    callback register();
    callback logout();

    // ---- данные
    in property <[GuildItem]> guilds;
    in property <string> guild-name;
    in property <[ChannelItem]> channels;
    in property <string> channel-name;
    in property <bool> can-write;
    in property <[Msg]> messages;
    in property <[Member]> members;
    in property <string> me-name;
    in property <string> me-initial;
    in property <color> me-tint;
    /// Строка состояния: «нет связи…», ошибки отправки
    in property <string> status;

    /// Долистали до начала ленты: пора подгрузить сообщения постарше
    callback load-older();
    callback select-guild(int);
    callback select-channel(int);
    callback send(string);
    callback create-guild-dialog();
    callback join-guild-dialog();
    callback invite();

    // ---- диалоги: "", "create", "join", "invite"
    in-out property <string> dialog;
    in-out property <string> dialog-value;
    callback dialog-ok();

    public pure function near-bottom() -> bool {
        list.content-y - (list.visible-height - list.content-height) < 80px
    }
    public pure function content-height() -> length {
        list.content-height
    }
    /// Сдвинуть ленту на delta: после вставки сообщений сверху сохраняем видимое место
    public function shift-scroll(delta: length) {
        list.content-y = max(list.visible-height - list.content-height, min(0px, list.content-y - delta));
    }
    public function scroll-to-bottom() {
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
    // Для бенчмарка: прокрутка на delta; true — упёрлись в край
    public function scroll-by(delta: length) -> bool {
        list.content-y = max(list.visible-height - list.content-height, min(0px, list.content-y + delta));
        list.content-y == 0px || list.content-y == list.visible-height - list.content-height
    }

    if !logged-in: LoginScreen {
        server-url <=> root.server-url;
        username <=> root.login-name;
        password <=> root.login-password;
        error: root.login-error;
        busy: root.login-busy;
        login => { root.login(); }
        register => { root.register(); }
    }

    // ListView лежит вне `if`, чтобы функции прокрутки могли к нему обращаться;
    // на экране входа область чата просто не видна (её закрывает LoginScreen выше по z)
    main := HorizontalLayout {
        visible: logged-in;
        // ---- Список серверов
        VerticalLayout {
            width: 64px;
            padding-top: 12px;
            spacing: 8px;
            alignment: start;
            for g[i] in guilds: HorizontalLayout {
                alignment: center;
                Rectangle {
                    property <bool> lit: g.active || sta.has-hover;
                    width: 44px;
                    height: 44px;
                    border-radius: lit ? 14px : 22px;
                    background: lit ? Theme.accent : Theme.bg2;
                    animate border-radius, background { duration: 150ms; }
                    sta := TouchArea { clicked => { root.select-guild(i); } }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: g.initial;
                        color: lit ? #fff : Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if g.unread && !g.active: Rectangle {
                        x: -10px;
                        y: (parent.height - self.height) / 2;
                        width: 4px;
                        height: 8px;
                        border-radius: 2px;
                        background: Theme.text;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 32px; height: 2px; background: Theme.bg2; }
            }
            // Создать сервер / войти по приглашению
            for action[i] in [
                "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z",
                "M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z",
            ]: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: ata.has-hover ? 14px : 22px;
                    background: ata.has-hover ? #3ba55c : Theme.bg2;
                    animate border-radius, background { duration: 150ms; }
                    ata := TouchArea {
                        clicked => {
                            if (i == 0) { root.create-guild-dialog(); } else { root.join-guild-dialog(); }
                        }
                    }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        commands: action;
                        fill: ata.has-hover ? #fff : #3ba55c;
                    }
                }
            }
        }

        // ---- Каналы
        Rectangle {
            width: 232px;
            background: Theme.bg1;
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        Text {
                            text: guild-name;
                            color: Theme.text;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if guild-name != "": VerticalLayout {
                            alignment: center;
                            IconButton {
                                // «Пригласить»: человек с плюсом
                                icon: "M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
                                clicked => { root.invite(); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                VerticalLayout {
                    padding: 8px;
                    padding-top: 4px;
                    spacing: 2px;
                    alignment: start;
                    vertical-stretch: 1;
                    for c[i] in channels: ChannelRow {
                        c: c;
                        clicked => { root.select-channel(i); }
                    }
                }
                Rectangle {
                    height: 52px;
                    background: Theme.bg0;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Avatar { size: 32px; initial: me-initial; tint: me-tint; }
                        }
                        Text {
                            text: me-name;
                            color: Theme.text;
                            font-weight: 600;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                // «Выйти»
                                icon: "M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z";
                                clicked => { root.logout(); }
                            }
                        }
                    }
                }
            }
        }

        // ---- Чат
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg2;
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text {
                            text: channel-name == "" ? "" : "# " + channel-name;
                            color: Theme.text;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: status;
                            color: Theme.danger;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                // ListView виртуализирован: создаются только видимые строки
                list := ListView {
                    vertical-stretch: 1;
                    changed content-y => {
                        if (self.content-y > -200px && self.content-height > self.visible-height) {
                            root.load-older();
                        }
                    }
                    for m in messages: MessageRow { m: m; }
                }
                Rectangle {
                    height: 64px;
                    Rectangle {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 44px;
                        border-radius: 8px;
                        background: Theme.hover;
                        input := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            color: Theme.text;
                            vertical-alignment: center;
                            read-only: !can-write;
                            accepted => {
                                if (self.text != "" && can-write) {
                                    root.send(self.text);
                                    self.text = "";
                                }
                            }
                        }
                        if input.text == "": Text {
                            x: 14px;
                            height: parent.height;
                            text: can-write ? "Написать в #" + channel-name : "Выберите текстовый канал";
                            color: Theme.dim;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---- Участники
        Rectangle {
            width: 220px;
            background: Theme.bg1;
            VerticalLayout {
                padding: 8px;
                padding-top: 12px;
                spacing: 2px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        height: 28px;
                        text: "УЧАСТНИКИ — " + members.length;
                        color: Theme.dim;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                for u in members: Rectangle {
                    height: 42px;
                    border-radius: 4px;
                    background: mta.has-hover ? Theme.hover : transparent;
                    mta := TouchArea { }
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Avatar { size: 32px; initial: u.initial; tint: u.tint; }
                        }
                        Text {
                            text: u.name;
                            color: mta.has-hover ? Theme.text : Theme.dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    if dialog == "create": Dialog {
        title: "Новый сервер";
        hint: "Свой сервер для клана, гильдии или друзей.";
        ok-text: "Создать";
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "join": Dialog {
        title: "Войти по приглашению";
        hint: "Вставьте код приглашения, который вам прислали.";
        ok-text: "Войти";
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "invite": Dialog {
        title: "Пригласить друзей";
        hint: "Отправьте этот код другу. В Feather: кнопка со стрелкой слева → вставить код.";
        read-only: true;
        value <=> root.dialog-value;
        cancel => { root.dialog = ""; }
    }
}
