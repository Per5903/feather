// Клиент Feather на Slint. Правила лёгкости (docs/02-performance.md):
// никаких тяжёлых эффектов, анимации только простые, списки виртуализированы.

import { ListView, LineEdit, Button, ComboBox, Switch } from "std-widgets.slint";
import { Theme, Fonts, Avatar, Icon, IconButton, Field, SettingRow, Backdrop, LinkButton, ListRow, RoleToggle, MentionItem } from "common.slint";
import { AccountDialog, GuildSettingsDialog, ChannelSettingsDialog, AdminDialog, VolumeDialog, MessageListDialog, EmojiPicker, ScreenDialog } from "dialogs.slint";

export { ListRow, RoleToggle, MentionItem, Fonts }

export struct ReactionChip {
    emoji: string,
    count: int,
    /// Моя реакция (подсвечена; клик — убрать)
    me: bool,
}

export struct Msg {
    head: bool,
    author: string,
    initial: string,
    tint: color,
    avatar: image,
    has-avatar: bool,
    time: string,
    /// Текст с разметкой (жирный, курсив, `код`, ссылки, @упоминания)
    body: styled-text,
    /// Есть разметка: рисуем StyledText; нет — обычный Text (он умеет переносить строки)
    rich: bool,
    text: string,
    edited: bool,
    /// Своё сообщение (можно редактировать) / можно удалить (своё или модератор)
    own: bool,
    can-delete: bool,
    can-pin: bool,
    can-thread: bool,
    pinned: bool,
    /// Меня упомянули (@имя): строка подсвечивается
    mention: bool,
    /// Ответ на сообщение: кому и начало его текста
    reply-author: string,
    reply-text: string,
    reply-tint: color,
    has-image: bool,
    img-w: length,
    img-h: length,
    img-label: string,
    img-tint: color,
    /// Загруженное превью (пока нет — показывается заглушка img-tint)
    image: image,
    image-loaded: bool,
    /// Прочие вложения строками: «имя · размер»
    files: string,
    reactions: [ReactionChip],
    /// Ветка, начатая с этого сообщения
    thread-name: string,
    /// Превью ссылки
    embed-site: string,
    embed-title: string,
    embed-desc: string,
}

export struct Member {
    name: string,
    initial: string,
    tint: color,
    avatar: image,
    has-avatar: bool,
    /// Показывать кнопку «Написать» (не я)
    can-message: bool,
    /// Показывать кнопки «Выгнать» / «Забанить» (есть право и я выше по роли)
    can-kick: bool,
    can-ban: bool,
    /// Показывать кнопку «Роли» (могу выдавать роли)
    can-roles: bool,
}

export struct GuildItem {
    name: string,
    initial: string,
    active: bool,
    unread: bool,
}

export enum ChannelKind { text, voice, category, dm, thread }

export struct VoiceMember {
    id: string,
    name: string,
    initial: string,
    tint: color,
    avatar: image,
    has-avatar: bool,
    speaking: bool,
    muted: bool,
    me: bool,
    /// Громкость у меня не 100%
    volume-changed: bool,
    /// Показывает экран
    live: bool,
}

export struct ChannelItem {
    name: string,
    kind: ChannelKind,
    active: bool,
    unread: bool,
    /// Кто сидит в голосовом канале
    voice-members: [VoiceMember],
    /// У категории кнопка «+» (создать канал) — только тем, кто может
    can-add: bool,
    /// Шестерёнка настроек канала при наведении
    can-manage: bool,
    /// Закрытый канал (замок)
    private: bool,
}

export struct RoleItem {
    name: string,
    tint: color,
    selected: bool,
    /// Можно редактировать (ниже моей роли)
    editable: bool,
}

export struct PermItem {
    title: string,
    hint: string,
    checked: bool,
}

/// Кнопка панели действий над сообщением
component ActionButton inherits IconButton {
    width: 30px;
    height: 28px;
}

// Строка сама — TouchArea: кнопки действий её потомки, и наведение не «теряется» при переходе на них
component MessageRow inherits TouchArea {
    in property <Msg> m;
    callback edit();
    callback delete();
    callback reply();
    callback react();
    callback toggle-reaction(string);
    callback pin();
    callback thread();
    callback open-thread();
    callback copy-text();
    callback open-image();
    callback open-files();
    callback open-link(string);
    callback open-embed();
    Rectangle { background: m.mention ? #f0b23214 : root.has-hover ? Theme.row-hover : transparent; }
    if m.mention: Rectangle {
        x: 0;
        width: 2px;
        background: #f0b232;
    }
    menu := ContextMenuArea {
        Menu {
            MenuItem { title: "Ответить"; activated => { root.reply(); } }
            MenuItem { title: "Реакция…"; activated => { root.react(); } }
            if m.can-thread: MenuItem { title: "Создать ветку"; activated => { root.thread(); } }
            if m.can-pin: MenuItem { title: m.pinned ? "Открепить" : "Закрепить"; activated => { root.pin(); } }
            MenuItem { title: "Копировать текст"; activated => { root.copy-text(); } }
            if m.own: MenuItem { title: "Изменить"; activated => { root.edit(); } }
            if m.can-delete: MenuItem { title: "Удалить"; activated => { root.delete(); } }
        }
    }
    VerticalLayout {
        padding-top: m.head || m.reply-author != "" ? 10px : 2px;
        padding-bottom: 2px;
        // Ответ: «↱ Имя: начало сообщения»
        if m.reply-author != "": HorizontalLayout {
            padding-left: 36px;
            padding-right: 16px;
            spacing: 6px;
            height: 20px;
            Rectangle {
                width: 30px;
                Rectangle { x: 0; y: parent.height / 2; width: 2px; height: parent.height / 2 + 4px; background: Theme.active; }
                Rectangle { x: 0; y: parent.height / 2; width: parent.width; height: 2px; background: Theme.active; }
            }
            Text { text: m.reply-author; color: m.reply-tint; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
            Text { text: m.reply-text; color: Theme.dim; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;
            VerticalLayout {
                alignment: start;
                width: 40px;
                if m.head: Avatar {
                    initial: m.initial;
                    tint: m.tint;
                    image: m.avatar;
                    has-image: m.has-avatar;
                }
                if !m.head: Text {
                    height: 22px;
                    text: root.has-hover ? m.time : "";
                    color: Theme.dim;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                spacing: 2px;
                if m.head: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Text {
                        text: m.author;
                        color: m.tint;
                        font-weight: 600;
                    }
                    Text {
                        text: m.time;
                        color: Theme.dim;
                        font-size: 12px;
                        vertical-alignment: bottom;
                    }
                    if m.pinned: VerticalLayout {
                        alignment: end;
                        Icon {
                            width: 13px;
                            height: 13px;
                            commands: "M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z";
                            fill: Theme.warn;
                        }
                    }
                }
                if m.rich: StyledText {
                    text: m.body;
                    default-color: Theme.text;
                    link-color: Theme.accent;
                    link-clicked(url) => { root.open-link(url); }
                }
                if !m.rich && (m.text != "" || m.edited): Text {
                    text: m.edited ? m.text + "  (изменено)" : m.text;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if m.embed-title != "" || m.embed-desc != "": HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    Rectangle {
                        max-width: 460px;
                        background: Theme.bg1;
                        border-radius: 6px;
                        HorizontalLayout {
                            Rectangle { width: 4px; background: Theme.accent; border-radius: 2px; }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                if m.embed-site != "": Text { text: m.embed-site; color: Theme.dim; font-size: 12px; overflow: elide; }
                                if m.embed-title != "": eta := TouchArea {
                                    mouse-cursor: pointer;
                                    height: et.preferred-height;
                                    clicked => { root.open-embed(); }
                                    et := Text {
                                        width: parent.width;
                                        horizontal-alignment: left;
                                        text: m.embed-title;
                                        color: eta.has-hover ? Theme.text : Theme.accent;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                }
                                if m.embed-desc != "": Text { text: m.embed-desc; color: Theme.dim; font-size: 13px; wrap: word-wrap; }
                            }
                        }
                    }
                }
                if m.has-image: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    Rectangle {
                        width: m.img-w;
                        height: m.img-h;
                        border-radius: 8px;
                        background: m.image-loaded ? transparent : m.img-tint;
                        clip: true;
                        if m.image-loaded: Image {
                            width: parent.width;
                            height: parent.height;
                            source: m.image;
                            image-fit: cover;
                        }
                        if !m.image-loaded: Text {
                            width: parent.width;
                            height: parent.height;
                            text: m.img-label;
                            color: #0000008c;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-image(); }
                        }
                    }
                }
                if m.files != "": fta := TouchArea {
                    mouse-cursor: pointer;
                    height: ftext.preferred-height + 12px;
                    clicked => { root.open-files(); }
                    Rectangle {
                        border-radius: 6px;
                        background: fta.has-hover ? Theme.active : Theme.bg1;
                    }
                    HorizontalLayout {
                        padding: 6px;
                        padding-left: 10px;
                        spacing: 8px;
                        Icon {
                            y: 2px;
                            // Скрепка
                            commands: "M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5a2.5 2.5 0 0 0 5 0V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z";
                            fill: Theme.accent;
                        }
                        ftext := Text {
                            text: m.files;
                            color: Theme.accent;
                            wrap: word-wrap;
                        }
                    }
                }
                if m.thread-name != "": HorizontalLayout {
                    alignment: start;
                    padding-top: 2px;
                    tta := TouchArea {
                        mouse-cursor: pointer;
                        width: tl.preferred-width + 20px;
                        height: 26px;
                        clicked => { root.open-thread(); }
                        Rectangle { border-radius: 6px; background: tta.has-hover ? Theme.active : Theme.bg1; }
                        tl := Text {
                            text: "💬 Ветка «" + m.thread-name + "» →";
                            color: Theme.accent;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if m.reactions.length > 0: HorizontalLayout {
                    alignment: start;
                    padding-top: 4px;
                    spacing: 4px;
                    for r in m.reactions: rta := TouchArea {
                        width: rl.preferred-width;
                        height: 24px;
                        clicked => { root.toggle-reaction(r.emoji); }
                        Rectangle {
                            border-radius: 8px;
                            background: r.me ? #6c8cff33 : rta.has-hover ? Theme.active : Theme.bg1;
                            border-width: 1px;
                            border-color: r.me ? Theme.accent : transparent;
                        }
                        rl := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 9px;
                            spacing: 4px;
                            Text { text: r.emoji; font-family: Fonts.emoji; font-size: 14px; vertical-alignment: center; }
                            Text { text: r.count; color: r.me ? Theme.text : Theme.dim; font-size: 13px; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
    // Действия при наведении: реакция, ответ, ещё (меню)
    if root.has-hover: Rectangle {
        x: parent.width - self.width - 16px;
        y: -10px;
        width: actions.preferred-width;
        height: 30px;
        border-radius: 6px;
        background: Theme.bg1;
        border-width: 1px;
        border-color: Theme.border;
        actions := HorizontalLayout {
            padding: 1px;
            ActionButton {
                // Смайлик: реакция
                icon: "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z";
                clicked => { root.react(); }
            }
            ActionButton {
                // Стрелка: ответить
                icon: "M10 9V5l-7 7 7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z";
                clicked => { root.reply(); }
            }
            if m.own: ActionButton {
                icon: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z";
                clicked => { root.edit(); }
            }
            ActionButton {
                // Три точки: остальное в меню
                icon: "M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z";
                clicked => { menu.show({ x: root.width - 60px, y: 24px }); }
            }
        }
    }
}

component ChannelRow inherits VerticalLayout {
    in property <ChannelItem> c;
    callback clicked();
    callback add();
    callback settings();
    callback voice-member(string);
    callback watch(string);
    Rectangle {
        property <bool> lit: c.active || c.unread || cta.has-hover;
        height: c.kind == ChannelKind.category ? 30px : c.kind == ChannelKind.thread ? 28px : 32px;
        border-radius: 4px;
        background: c.kind == ChannelKind.category ? transparent : c.active ? Theme.active : cta.has-hover ? Theme.hover : transparent;
        cta := TouchArea { clicked => { root.clicked(); } }
        // Метка непрочитанного слева, как в Discord
        if c.unread && !c.active: Rectangle {
            x: -8px;
            y: (parent.height - self.height) / 2;
            width: 4px;
            height: 8px;
            border-radius: 2px;
            background: Theme.text;
        }
        HorizontalLayout {
            padding-left: c.kind == ChannelKind.thread ? 26px : 8px;
            padding-right: 2px;
            spacing: 6px;
            if c.kind == ChannelKind.voice: VerticalLayout {
                alignment: center;
                Icon {
                    width: 14px;
                    height: 14px;
                    commands: "M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4z";
                    fill: lit ? Theme.text : Theme.dim;
                }
            }
            Text {
                text: c.kind == ChannelKind.text ? "# " + c.name : c.kind == ChannelKind.dm ? "@ " + c.name : c.kind == ChannelKind.thread ? "↳ " + c.name : c.name;
                color: c.kind == ChannelKind.category ? Theme.dim : lit ? Theme.text : Theme.dim;
                font-size: c.kind == ChannelKind.category ? 12px : c.kind == ChannelKind.thread ? 14px : 15px;
                font-weight: c.kind == ChannelKind.category || c.unread ? 600 : 400;
                vertical-alignment: c.kind == ChannelKind.category ? bottom : center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if c.private: VerticalLayout {
                alignment: c.kind == ChannelKind.category ? end : center;
                Icon {
                    width: 12px;
                    height: 12px;
                    // Замок: закрытый канал
                    commands: "M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z";
                    fill: Theme.dim;
                }
            }
            if c.can-manage && cta.has-hover: VerticalLayout {
                alignment: c.kind == ChannelKind.category ? end : center;
                Rectangle {
                    width: 22px;
                    height: 20px;
                    gta := TouchArea { clicked => { root.settings(); } }
                    Icon {
                        x: 3px;
                        y: 2px;
                        width: 15px;
                        height: 15px;
                        commands: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                        fill: gta.has-hover ? Theme.text : Theme.dim;
                    }
                }
            }
            if c.can-add: VerticalLayout {
                alignment: end;
                Rectangle {
                    width: 22px;
                    height: 20px;
                    ata := TouchArea { clicked => { root.add(); } }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "+";
                        font-size: 18px;
                        color: ata.has-hover ? Theme.text : Theme.dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    for m in c.voice-members: vta := TouchArea {
        height: 30px;
        mouse-cursor: m.me ? default : pointer;
        clicked => { if (!m.me) { root.voice-member(m.id); } }
        Rectangle { border-radius: 4px; background: vta.has-hover && !m.me ? Theme.hover : transparent; }
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 6px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Avatar {
                    size: 24px;
                    initial: m.initial;
                    tint: m.tint;
                    image: m.avatar;
                    has-image: m.has-avatar;
                    // Зелёное кольцо — человек говорит
                    border-width: m.speaking ? 2px : 0px;
                    border-color: #3ba55c;
                }
            }
            Text {
                text: m.name;
                color: m.speaking ? Theme.text : Theme.dim;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if m.live: VerticalLayout {
                alignment: center;
                lta := TouchArea {
                    width: 52px;
                    height: 18px;
                    mouse-cursor: pointer;
                    // Свой значок — предпросмотр своего показа
                    clicked => { root.watch(m.id); }
                    Rectangle { border-radius: 4px; background: lta.has-hover ? #ff5a5f : #ed4245; }
                    Text { text: "В ЭФИРЕ"; color: #fff; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if m.volume-changed: VerticalLayout {
                alignment: center;
                Icon {
                    width: 12px;
                    height: 12px;
                    // Динамик: громкость изменена
                    commands: "M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4z";
                    fill: Theme.dim;
                }
            }
            if m.muted: VerticalLayout {
                alignment: center;
                Icon {
                    width: 14px;
                    height: 14px;
                    // Перечёркнутый микрофон
                    commands: "M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99zM4.27 3L3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5.3-2.1-5.3-5.1H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c.91-.13 1.77-.45 2.54-.9L19.73 21 21 19.73 4.27 3z";
                    fill: Theme.danger;
                }
            }
        }
    }
}

component LoginScreen inherits Rectangle {
    in-out property <string> server-url;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> password2;
    in-out property <string> invite;
    /// false — вход, true — создание аккаунта
    in-out property <bool> register-mode;
    /// Подсказка о режиме регистрации на этом сервере Feather
    in property <string> registration-hint;
    /// Сервер попросил код двухфакторной защиты
    in property <bool> need-totp;
    in-out property <string> totp;
    in property <string> error;
    in property <bool> busy;
    callback login();
    callback register();
    callback mode-changed();
    background: Theme.bg0;
    Rectangle {
        width: 400px;
        height: form.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 12px;
        form := VerticalLayout {
            padding: 28px;
            spacing: 14px;
            Text {
                text: "Feather";
                font-size: 26px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: register-mode ? "Создание аккаунта" : "Вход";
                color: Theme.dim;
                horizontal-alignment: center;
            }
            Field {
                label: "АДРЕС FEATHER";
                LineEdit { text <=> root.server-url; enabled: !busy; placeholder-text: "например, chat.example.com"; }
            }
            Field {
                label: "ИМЯ";
                LineEdit { text <=> root.username; enabled: !busy; }
            }
            Field {
                label: "ПАРОЛЬ";
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    enabled: !busy;
                    accepted => { if (!register-mode) { root.login(); } }
                }
            }
            if need-totp && !register-mode: Field {
                label: "КОД ИЗ ПРИЛОЖЕНИЯ";
                LineEdit {
                    text <=> root.totp;
                    enabled: !busy;
                    placeholder-text: "6 цифр";
                    accepted => { root.login(); }
                }
            }
            if register-mode: Field {
                label: "ПОВТОРИТЕ ПАРОЛЬ";
                LineEdit { text <=> root.password2; input-type: InputType.password; enabled: !busy; }
            }
            if register-mode: Field {
                label: "КОД ПРИГЛАШЕНИЯ";
                LineEdit { text <=> root.invite; enabled: !busy; placeholder-text: "необязательно"; }
            }
            if register-mode && registration-hint != "": Text {
                text: registration-hint;
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if error != "": Text {
                text: error;
                color: Theme.danger;
                wrap: word-wrap;
            }
            Button {
                text: busy ? "Подключаюсь…" : register-mode ? "Создать аккаунт" : "Войти";
                primary: true;
                enabled: !busy;
                clicked => { if (register-mode) { root.register(); } else { root.login(); } }
            }
            HorizontalLayout {
                alignment: center;
                lta := TouchArea {
                    width: link.preferred-width;
                    height: link.preferred-height;
                    mouse-cursor: pointer;
                    clicked => {
                        root.register-mode = !root.register-mode;
                        root.mode-changed();
                    }
                    link := Text {
                        text: register-mode ? "Уже есть аккаунт? Войти" : "Нет аккаунта? Зарегистрироваться";
                        color: lta.has-hover ? Theme.text : Theme.accent;
                        font-size: 13px;
                    }
                }
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> ok-text;
    in property <bool> read-only;
    in-out property <string> value;
    /// Дополнительный переключатель (например «Голосовой канал»), если задана подпись
    in property <string> switch-label;
    in-out property <bool> switch-value;
    callback ok();
    callback cancel();
    background: #000000a8;
    // Перехватываем клики, чтобы они не уходили в окно под диалогом
    TouchArea { }
    Rectangle {
        width: 420px;
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 10px;
        box := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            if hint != "": Text {
                text: hint;
                color: Theme.dim;
                wrap: word-wrap;
            }
            LineEdit {
                text <=> root.value;
                read-only: root.read-only;
                accepted => { root.ok(); }
            }
            if switch-label != "": HorizontalLayout {
                spacing: 12px;
                Text {
                    text: switch-label;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Switch { checked <=> root.switch-value; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: ok-text == "" ? "Закрыть" : "Отмена";
                    clicked => { root.cancel(); }
                }
                if ok-text != "": Button {
                    text: ok-text;
                    primary: true;
                    clicked => { root.ok(); }
                }
            }
        }
    }
}

component SettingsDialog inherits Rectangle {
    in property <[string]> input-devices;
    in property <[string]> output-devices;
    in-out property <int> input-index;
    in-out property <int> output-index;
    in-out property <bool> ptt;
    in-out property <bool> noise;
    in-out property <bool> echo;
    in-out property <bool> economy;
    in-out property <bool> notify;
    in-out property <bool> sounds;
    in-out property <bool> updates;
    in property <string> ptt-key;
    callback save();
    callback cancel();
    callback configure-ptt();
    background: #000000a8;
    TouchArea { }
    Rectangle {
        width: 480px;
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 10px;
        box := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            Text {
                text: "Настройки";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            Field {
                label: "МИКРОФОН";
                ComboBox { model: input-devices; current-index <=> root.input-index; }
            }
            Field {
                label: "ВЫВОД ЗВУКА";
                ComboBox { model: output-devices; current-index <=> root.output-index; }
            }
            SettingRow {
                title: "Push-to-talk";
                hint: ptt ? (ptt-key == "" ? "Клавиша не назначена" : "Клавиша: " + ptt-key) : "Выключено: микрофон передаёт звук всё время";
                checked <=> root.ptt;
            }
            if ptt: HorizontalLayout {
                alignment: start;
                Button { text: "Назначить клавишу…"; clicked => { root.configure-ptt(); } }
            }
            SettingRow {
                title: "Уведомления";
                hint: "Личные сообщения и упоминания @вас, когда канал не открыт";
                checked <=> root.notify;
            }
            SettingRow {
                title: "Звуки входа и выхода";
                hint: "Короткий сигнал, когда кто-то заходит в ваш голосовой канал или выходит";
                checked <=> root.sounds;
            }
            SettingRow {
                title: "Шумоподавление";
                hint: "Нейросеть RNNoise: убирает шум вентилятора, клавиатуры, улицы";
                checked <=> root.noise;
            }
            SettingRow {
                title: "Эхоподавление";
                hint: "Нужно, если звук идёт в колонки. В наушниках можно выключить";
                checked <=> root.echo;
            }
            SettingRow {
                title: "Экономный режим";
                hint: "Отрисовка без видеокарты: в 3–4 раза меньше памяти. После перезапуска";
                checked <=> root.economy;
            }
            SettingRow {
                title: "Проверять обновления";
                hint: "Раз при запуске спрашивать GitHub, не вышла ли новая версия Feather";
                checked <=> root.updates;
            }
            Text {
                text: "Устройства и обработка звука применяются при следующем входе в голосовой канал.";
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Отмена"; clicked => { root.cancel(); } }
                Button { text: "Сохранить"; primary: true; clicked => { root.save(); } }
            }
        }
    }
}

/// Окно «Роли сервера»: список ролей слева, свойства выбранной справа
component RolesDialog inherits Rectangle {
    in property <[RoleItem]> roles;
    in property <[PermItem]> perm-items;
    in-out property <string> role-name;
    in property <int> color-index;
    in property <bool> is-everyone;
    in property <bool> editable;
    callback select-role(int);
    callback create-role();
    callback save-role();
    callback delete-role();
    callback pick-color(int);
    callback close();
    background: #000000a8;
    TouchArea { }
    Rectangle {
        width: 640px;
        height: 520px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 10px;
        HorizontalLayout {
            // Список ролей
            Rectangle {
                width: 200px;
                background: Theme.bg0;
                border-radius: 10px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text { text: "Роли"; color: Theme.text; font-size: 18px; font-weight: 700; }
                    for r[i] in roles: rta := TouchArea {
                        height: 32px;
                        clicked => { root.select-role(i); }
                        Rectangle {
                            border-radius: 4px;
                            background: r.selected ? Theme.active : rta.has-hover ? Theme.hover : transparent;
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: r.tint; }
                            }
                            Text { text: r.name; color: r.tint; vertical-alignment: center; overflow: elide; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button { text: "Создать роль"; clicked => { root.create-role(); } }
                }
            }
            // Свойства роли
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                if !is-everyone: Field {
                    label: "НАЗВАНИЕ";
                    LineEdit { text <=> root.role-name; enabled: editable; }
                }
                if is-everyone: Text {
                    text: "@everyone — права всех участников сервера";
                    color: Theme.dim;
                    wrap: word-wrap;
                }
                if !is-everyone: Field {
                    label: "ЦВЕТ";
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c[i] in [#99aab5, #3ba55c, #6cb6ff, #c792ea, #f07178, #e8a14b, #ffcb6b, #5ccfe6]: Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: c;
                            border-width: i == color-index ? 3px : 0px;
                            border-color: Theme.text;
                            TouchArea { clicked => { if (editable) { root.pick-color(i); } } }
                        }
                    }
                }
                Text { text: "ПРАВА"; color: Theme.dim; font-size: 12px; font-weight: 600; }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for p in perm-items: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: p.title; color: Theme.text; }
                                Text { text: p.hint; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch { checked <=> p.checked; enabled: editable; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    if !is-everyone && editable: Button { text: "Удалить"; clicked => { root.delete-role(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Закрыть"; clicked => { root.close(); } }
                    if editable: Button { text: "Сохранить"; primary: true; clicked => { root.save-role(); } }
                }
            }
        }
    }
}

/// Окно «Роли участника»: переключатели ролей
component MemberRolesDialog inherits Rectangle {
    in property <string> member-name;
    in property <[PermItem]> items;
    callback save();
    callback close();
    background: #000000a8;
    TouchArea { }
    Rectangle {
        width: 380px;
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg1;
        border-radius: 10px;
        box := VerticalLayout {
            padding: 22px;
            spacing: 10px;
            Text { text: "Роли: " + member-name; color: Theme.text; font-size: 18px; font-weight: 700; }
            if items.length == 0: Text { text: "Нет ролей, которые вы можете выдавать."; color: Theme.dim; wrap: word-wrap; }
            for it in items: HorizontalLayout {
                spacing: 12px;
                Text { text: it.title; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                Switch { checked <=> it.checked; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Отмена"; clicked => { root.close(); } }
                Button { text: "Сохранить"; primary: true; clicked => { root.save(); } }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Feather";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;
    background: Theme.bg0;
    default-font-size: 15px;

    // ---- вход
    in property <bool> logged-in;
    in-out property <string> server-url;
    in-out property <string> login-name;
    in-out property <string> login-password;
    in-out property <string> login-password2;
    in-out property <string> login-invite;
    in-out property <string> login-totp;
    in property <bool> login-need-totp;
    in-out property <bool> register-mode;
    in property <string> registration-hint;
    callback login-mode-changed();
    in property <string> login-error;
    in property <bool> login-busy;
    callback login();
    callback register();
    callback logout();

    // ---- данные
    in property <[GuildItem]> guilds;
    in property <string> guild-name;
    in property <[ChannelItem]> channels;
    in property <string> channel-name;
    /// Открыт канал-ветка (в шапке другой значок)
    in property <bool> in-thread;
    in property <bool> can-write;
    in property <[Msg]> messages;
    in property <[Member]> members;
    in property <string> me-name;
    in property <string> me-initial;
    in property <color> me-tint;
    in property <image> me-avatar;
    in property <bool> me-has-avatar;
    /// Строка состояния: «нет связи…», ошибки отправки
    in property <string> status;
    /// Вышла новая версия: «0.2.0»; "" — нет
    in property <string> update-version;
    callback open-update();
    in property <bool> is-admin;
    callback open-admin();
    callback open-account();

    /// Долистали до начала ленты: пора подгрузить сообщения постарше
    callback load-older();
    callback select-guild(int);
    // ---- личные сообщения
    in property <bool> in-dm;
    in property <bool> home-unread;
    callback select-home();
    callback message-member(int);
    callback kick-member(int);
    callback ban-member(int);
    in property <bool> can-invite;
    // ---- роли
    in property <bool> can-manage-roles;
    in property <[RoleItem]> role-items;
    in property <[PermItem]> perm-items;
    in-out property <string> role-name;
    in property <int> role-color-index;
    in property <bool> role-is-everyone;
    in property <bool> role-editable;
    in property <string> roles-member-name;
    in property <[PermItem]> member-role-items;
    callback open-roles();
    callback select-role(int);
    callback create-role();
    callback save-role();
    callback delete-role();
    callback pick-role-color(int);
    callback member-roles(int);
    callback save-member-roles();

    // ---- голос
    /// Название голосового канала, к которому подключены; "" — не подключены
    in property <string> voice-channel;
    in property <string> voice-state;
    // Пинг до голосового сервера, мс (-1 — ещё неизвестен) и пометки о связи (TCP, потери)
    in property <int> voice-ping: -1;
    in property <string> voice-net;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    callback toggle-mute();
    callback voice-member(string);
    // ---- демонстрация экрана
    in property <bool> voice-sharing;
    callback toggle-screen();
    in property <[string]> screen-qualities;
    in-out property <int> screen-quality;
    in property <[string]> screen-sources;
    in-out property <int> screen-source;
    callback start-screen();
    callback watch-screen(string);
    /// Смотрю трансляцию: чья ("" — не смотрю), кадр, во весь экран
    in property <string> screen-name;
    in property <image> screen-image;
    in property <bool> screen-has-frame;
    in property <bool> screen-full;
    callback close-screen();
    callback toggle-fullscreen();
    // Громкость участника
    in property <string> volume-name;
    in-out property <float> volume-value;
    callback volume-changed(float);

    // ---- настройки
    in property <[string]> input-devices;
    in property <[string]> output-devices;
    in-out property <int> set-input;
    in-out property <int> set-output;
    in-out property <bool> set-ptt;
    in-out property <bool> set-noise;
    in-out property <bool> set-echo;
    in-out property <bool> set-economy;
    in-out property <bool> set-notify;
    in-out property <bool> set-sounds;
    in-out property <bool> set-updates;
    in property <string> ptt-key;
    callback open-settings();
    callback save-settings();
    callback configure-ptt();
    callback toggle-deafen();
    callback leave-voice();
    callback select-channel(int);
    callback channel-settings(int);
    callback send(string);
    /// Текст в поле ввода (Rust подставляет его при редактировании)
    in-out property <string> composer-text;
    /// Редактируется сообщение (поле ввода в режиме правки)
    in property <bool> editing;
    /// Ответ на сообщение: «Ответ для Имя»; "" — не отвечаем
    in property <string> reply-to;
    callback cancel-reply();
    /// «Шторм печатает…»
    in property <string> typing-text;
    callback edit-message(int);
    callback delete-message(int);
    callback reply-message(int);
    callback react-message(int);
    callback toggle-reaction(int, string);
    callback pin-message(int);
    callback thread-message(int);
    callback open-thread(int);
    callback copy-message(int);
    callback open-link(string);
    callback open-embed(int);
    callback cancel-edit();
    callback typing();
    /// Текст поля ввода изменился: подсказки @упоминаний
    callback composer-changed(string);
    in property <[MentionItem]> mentions;
    callback pick-mention(int);
    /// Ctrl+V: если в буфере картинка — Rust прикрепит её и вернёт true
    callback paste-image() -> bool;
    // ---- эмодзи: -2 — закрыто, -1 — для поля ввода, ≥0 — реакция на сообщение
    in-out property <int> emoji-for: -2;
    callback emoji-picked(string);
    // ---- шапка канала: закреплённые и поиск
    callback open-pins();
    callback open-search();
    // ---- вложения
    /// Прикреплённые к будущему сообщению файлы: «имя · загрузка…» / «имя · 1,2 МБ»
    in property <[string]> pending-files;
    callback attach();
    callback remove-pending(int);
    callback open-image(int);
    callback open-files(int);
    callback create-guild-dialog();
    callback join-guild-dialog();
    callback invite();
    callback add-channel(int);
    callback open-guild-settings();
    in-out property <bool> dialog-switch;

    // ---- диалоги: "", "create", "join", "invite", "settings", "account", "guild", "channel-settings", …
    in-out property <string> dialog;
    in-out property <string> dialog-value;
    callback dialog-ok();

    // ---- аккаунт
    in-out property <int> account-tab;
    in property <string> account-username;
    in-out property <string> account-display-name;
    in-out property <string> account-pw-current;
    in-out property <string> account-pw-new;
    in-out property <string> account-pw-new2;
    in property <bool> account-totp-enabled;
    in property <bool> account-totp-setup;
    in property <image> account-totp-qr;
    in property <string> account-totp-secret;
    in-out property <string> account-totp-code;
    in-out property <string> account-confirm-password;
    in property <string> account-message;
    in property <bool> account-message-ok;
    callback account-save-profile();
    callback account-pick-avatar();
    callback account-remove-avatar();
    callback account-change-password();
    callback account-start-totp();
    callback account-enable-totp();
    callback account-disable-totp();
    callback account-delete();

    // ---- настройки сообщества
    in-out property <int> guild-tab;
    in property <[string]> guild-tab-labels;
    in-out property <string> guild-edit-name;
    in property <bool> guild-can-manage;
    in property <bool> guild-is-owner;
    in property <[string]> guild-member-names;
    in-out property <int> guild-new-owner;
    in-out property <string> guild-confirm-name;
    in property <[ListRow]> guild-bans;
    in property <[ListRow]> guild-audit;
    in property <string> guild-message;
    in property <bool> guild-message-ok;
    callback guild-save-name();
    callback guild-transfer();
    callback guild-delete();
    callback guild-leave();
    callback guild-unban(int);
    callback guild-tab-changed(int);

    // ---- настройки канала
    in-out property <string> ch-name;
    in property <bool> ch-is-voice;
    in property <bool> ch-is-category;
    in-out property <bool> ch-private;
    in-out property <bool> ch-read-only;
    in property <[RoleToggle]> ch-roles;
    in property <string> ch-message;
    callback ch-save();
    callback ch-delete();

    // ---- администратор
    in-out property <int> admin-registration;
    in property <[ListRow]> admin-users;
    in property <string> admin-message;
    in property <bool> admin-message-ok;
    callback admin-set-registration(int);
    callback admin-reset-password(int);
    callback admin-delete-user(int);

    // ---- списки сообщений: поиск, закреплённые
    in property <string> list-title;
    in property <string> list-empty;
    in property <[ListRow]> list-rows;
    in-out property <string> search-query;
    in property <bool> list-searchable;
    callback list-search();
    callback list-open(int);
    callback list-action(int);

    public pure function near-bottom() -> bool {
        list.content-y - (list.visible-height - list.content-height) < 80px
    }
    public pure function content-height() -> length {
        list.content-height
    }
    /// Сдвинуть ленту на delta: после вставки сообщений сверху сохраняем видимое место
    public function shift-scroll(delta: length) {
        list.content-y = max(list.visible-height - list.content-height, min(0px, list.content-y - delta));
    }
    public function scroll-to-bottom() {
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
    // Для бенчмарка: прокрутка на delta; true — упёрлись в край
    public function scroll-by(delta: length) -> bool {
        list.content-y = max(list.visible-height - list.content-height, min(0px, list.content-y + delta));
        list.content-y == 0px || list.content-y == list.visible-height - list.content-height
    }
    public function focus-composer() {
        input.focus();
    }

    if !logged-in: LoginScreen {
        server-url <=> root.server-url;
        username <=> root.login-name;
        password <=> root.login-password;
        password2 <=> root.login-password2;
        invite <=> root.login-invite;
        totp <=> root.login-totp;
        need-totp: root.login-need-totp;
        register-mode <=> root.register-mode;
        registration-hint: root.registration-hint;
        mode-changed => { root.login-mode-changed(); }
        error: root.login-error;
        busy: root.login-busy;
        login => { root.login(); }
        register => { root.register(); }
    }

    // ListView лежит вне `if`, чтобы функции прокрутки могли к нему обращаться;
    // на экране входа область чата просто не видна (её закрывает LoginScreen выше по z)
    main := HorizontalLayout {
        visible: logged-in;
        // ---- Список серверов (во весь экран трансляции — скрыт)
        if !screen-full: VerticalLayout {
            width: 64px;
            padding-top: 12px;
            spacing: 8px;
            alignment: start;
            // Личные сообщения
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    property <bool> lit: in-dm || hta.has-hover;
                    width: 44px;
                    height: 44px;
                    border-radius: lit ? 14px : 22px;
                    background: lit ? Theme.accent : Theme.bg2;
                    animate border-radius, background { duration: 150ms; }
                    hta := TouchArea { clicked => { root.select-home(); } }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 22px;
                        // Облачко чата
                        commands: "M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z";
                        fill: lit ? #fff : Theme.text;
                    }
                    if home-unread && !in-dm: Rectangle {
                        x: -10px;
                        y: (parent.height - self.height) / 2;
                        width: 4px;
                        height: 8px;
                        border-radius: 2px;
                        background: Theme.text;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 32px; height: 2px; background: Theme.bg2; }
            }
            for g[i] in guilds: HorizontalLayout {
                alignment: center;
                Rectangle {
                    property <bool> lit: g.active || sta.has-hover;
                    width: 44px;
                    height: 44px;
                    border-radius: lit ? 14px : 22px;
                    background: lit ? Theme.accent : Theme.bg2;
                    animate border-radius, background { duration: 150ms; }
                    sta := TouchArea { clicked => { root.select-guild(i); } }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: g.initial;
                        color: lit ? #fff : Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if g.unread && !g.active: Rectangle {
                        x: -10px;
                        y: (parent.height - self.height) / 2;
                        width: 4px;
                        height: 8px;
                        border-radius: 2px;
                        background: Theme.text;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 32px; height: 2px; background: Theme.bg2; }
            }
            // Создать сервер / войти по приглашению
            for action[i] in [
                "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z",
                "M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z",
            ]: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: ata.has-hover ? 14px : 22px;
                    background: ata.has-hover ? #3ba55c : Theme.bg2;
                    animate border-radius, background { duration: 150ms; }
                    ata := TouchArea {
                        clicked => {
                            if (i == 0) { root.create-guild-dialog(); } else { root.join-guild-dialog(); }
                        }
                    }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        commands: action;
                        fill: ata.has-hover ? #fff : #3ba55c;
                    }
                }
            }
        }

        // ---- Каналы
        if !screen-full: Rectangle {
            width: 232px;
            background: Theme.bg1;
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 6px;
                        Text {
                            text: guild-name;
                            color: Theme.text;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if guild-name != "" && !in-dm && can-manage-roles: VerticalLayout {
                            alignment: center;
                            IconButton {
                                // «Роли сервера»: щит
                                icon: "M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z";
                                clicked => { root.open-roles(); }
                            }
                        }
                        if guild-name != "" && !in-dm && can-invite: VerticalLayout {
                            alignment: center;
                            IconButton {
                                // «Пригласить»: человек с плюсом
                                icon: "M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
                                clicked => { root.invite(); }
                            }
                        }
                        if guild-name != "" && !in-dm: VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Настройки сообщества: шестерёнка
                                icon: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                                clicked => { root.open-guild-settings(); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 8px;
                        padding-top: 4px;
                        spacing: 2px;
                        alignment: start;
                        for c[i] in channels: ChannelRow {
                            c: c;
                            clicked => { root.select-channel(i); }
                            add => { root.add-channel(i); }
                            settings => { root.channel-settings(i); }
                            voice-member(id) => { root.voice-member(id); }
                            watch(id) => { root.watch-screen(id); }
                        }
                    }
                }
                if voice-channel != "": Rectangle {
                    height: 56px;
                    background: Theme.bg0;
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: voice-state;
                                color: voice-state == "Голос подключён" ? #3ba55c : #faa61a;
                                font-size: 13px;
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: voice-channel;
                                    color: Theme.dim;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                if voice-ping >= 0: Text {
                                    text: voice-ping + " мс";
                                    color: voice-ping < 80 ? #3ba55c : voice-ping < 150 ? #faa61a : #ed4245;
                                    font-size: 12px;
                                    horizontal-stretch: 0;
                                }
                                if voice-net != "": Text {
                                    text: voice-net;
                                    color: #faa61a;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Показать экран: монитор со стрелкой
                                icon: "M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h3l-1 1v2h12v-2l-1-1h3c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11zM12 6.5 8.5 10H11v4h2v-4h2.5z";
                                on: voice-sharing;
                                on-color: Theme.ok;
                                clicked => { root.toggle-screen(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Отключиться: трубка
                                icon: "M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.7.28-.28 0-.53-.11-.71-.29L.29 13.08c-.18-.17-.29-.42-.29-.7 0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.69-1.36-2.67-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z";
                                clicked => { root.leave-voice(); }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 52px;
                    background: Theme.bg0;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        // Я: аватар и имя — открывают «Мой аккаунт»
                        meta := TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.open-account(); }
                            Rectangle { border-radius: 4px; background: meta.has-hover ? Theme.hover : transparent; }
                            HorizontalLayout {
                                padding-left: 2px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Avatar { size: 32px; initial: me-initial; tint: me-tint; image: me-avatar; has-image: me-has-avatar; }
                                }
                                Text {
                                    text: me-name;
                                    color: Theme.text;
                                    font-weight: 600;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if voice-channel != "": VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Микрофон: обычный или перечёркнутый
                                icon: voice-muted
                                    ? "M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99zM4.27 3L3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5.3-2.1-5.3-5.1H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c.91-.13 1.77-.45 2.54-.9L19.73 21 21 19.73 4.27 3z"
                                    : "M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z";
                                on: voice-muted;
                                on-color: Theme.danger;
                                clicked => { root.toggle-mute(); }
                            }
                        }
                        if voice-channel != "": VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Звук: наушники
                                icon: voice-deafened
                                    ? "M12 4c-3.87 0-7 3.13-7 7v.17l2 2V11c0-2.76 2.24-5 5-5s5 2.24 5 5v1.17l1.97 1.97c.02-.17.03-.33.03-.5V11c0-3.87-3.13-7-7-7zM3.27 2.5L2 3.77l3 3C4.38 7.98 4 9.45 4 11v7c0 1.66 1.34 3 3 3h3v-8H6v-2c0-.82.21-1.6.57-2.29l10.77 10.77c-.34.31-.79.52-1.34.52h-3v2h3c1.07 0 2.04-.43 2.75-1.12l1.48 1.48L22.5 21.23 3.27 2.5z"
                                    : "M12 3c-4.97 0-9 4.03-9 9v7c0 1.1.9 2 2 2h4v-8H5v-1c0-3.87 3.13-7 7-7s7 3.13 7 7v1h-4v8h4c1.1 0 2-.9 2-2v-7c0-4.97-4.03-9-9-9z";
                                on: voice-deafened;
                                on-color: Theme.danger;
                                clicked => { root.toggle-deafen(); }
                            }
                        }
                        if is-admin: VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Администрирование: ключ
                                icon: "M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z";
                                clicked => { root.open-admin(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Настройки: шестерёнка
                                icon: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                                clicked => { root.open-settings(); }
                            }
                        }
                    }
                }
            }
        }

        // ---- Чат (или трансляция поверх него)
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg2;
            if screen-name != "": Rectangle {
                z: 10;
                background: #000;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: screen-image;
                    image-fit: contain;
                    visible: screen-has-frame;
                }
                if !screen-has-frame: Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Подключаюсь к трансляции…";
                    color: Theme.dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    double-clicked => { root.toggle-fullscreen(); }
                }
                Rectangle {
                    y: 0;
                    height: 44px;
                    background: #000000a0;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 6px;
                        Rectangle {
                            width: 58px;
                            height: 20px;
                            y: 12px;
                            border-radius: 4px;
                            background: #ed4245;
                            Text { text: "В ЭФИРЕ"; color: #fff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: screen-name; color: #fff; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Во весь экран / обратно
                                icon: screen-full
                                    ? "M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"
                                    : "M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z";
                                clicked => { root.toggle-fullscreen(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Закрыть просмотр
                                icon: "M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
                                clicked => { root.close-screen(); }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                if update-version != "": uta := TouchArea {
                    height: 30px;
                    mouse-cursor: pointer;
                    clicked => { root.open-update(); }
                    Rectangle { background: uta.has-hover ? #5a78e8 : Theme.accent; }
                    Text {
                        text: "Вышла новая версия Feather " + update-version + " — скачать";
                        color: #fff;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: channel-name == "" ? "" : (in-dm ? "@ " : in-thread ? "↳ " : "# ") + channel-name;
                            color: Theme.text;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: status;
                            color: Theme.danger;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if channel-name != "": VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Закреплённые: булавка
                                icon: "M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z";
                                clicked => { root.open-pins(); }
                            }
                        }
                        if channel-name != "": VerticalLayout {
                            alignment: center;
                            IconButton {
                                // Поиск: лупа
                                icon: "M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
                                clicked => { root.open-search(); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                // ListView виртуализирован: создаются только видимые строки
                list := ListView {
                    vertical-stretch: 1;
                    changed content-y => {
                        if (self.content-y > -200px && self.content-height > self.visible-height) {
                            root.load-older();
                        }
                    }
                    for m[i] in messages: MessageRow {
                        m: m;
                        edit => { root.edit-message(i); }
                        delete => { root.delete-message(i); }
                        reply => { root.reply-message(i); }
                        react => { root.react-message(i); }
                        toggle-reaction(e) => { root.toggle-reaction(i, e); }
                        pin => { root.pin-message(i); }
                        thread => { root.thread-message(i); }
                        open-thread => { root.open-thread(i); }
                        copy-text => { root.copy-message(i); }
                        open-image => { root.open-image(i); }
                        open-files => { root.open-files(i); }
                        open-link(url) => { root.open-link(url); }
                        open-embed => { root.open-embed(i); }
                    }
                }
                if pending-files.length > 0: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    alignment: start;
                    for f[i] in pending-files: Rectangle {
                        height: 26px;
                        width: chip.preferred-width;
                        border-radius: 13px;
                        background: Theme.bg1;
                        chip := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 4px;
                            Text { text: f; color: Theme.text; font-size: 12px; vertical-alignment: center; }
                            Rectangle {
                                width: 20px;
                                xta := TouchArea { clicked => { root.remove-pending(i); } }
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "×";
                                    color: xta.has-hover ? Theme.danger : Theme.dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                // Подсказки @упоминаний над полем ввода
                if mentions.length > 0: Rectangle {
                    height: mlist.preferred-height + 8px;
                    Rectangle {
                        x: 16px;
                        width: parent.width - 32px;
                        background: Theme.bg1;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        mlist := VerticalLayout {
                            padding: 4px;
                            for mi[i] in mentions: mita := TouchArea {
                                height: 34px;
                                clicked => { root.pick-mention(i); }
                                Rectangle { border-radius: 4px; background: mita.has-hover || i == 0 ? Theme.hover : transparent; }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Avatar { size: 24px; initial: mi.initial; tint: mi.tint; image: mi.avatar; has-image: mi.has-avatar; }
                                    }
                                    Text { text: mi.name; color: Theme.text; vertical-alignment: center; }
                                    if i == 0: Text { text: "Tab"; color: Theme.dim; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
                if reply-to != "" && !editing: HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 16px;
                    height: 24px;
                    Text {
                        text: reply-to;
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    LinkButton { text: "Отмена"; color: Theme.dim; font-size: 12px; clicked => { root.cancel-reply(); } }
                }
                if editing: HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 16px;
                    height: 24px;
                    Text {
                        text: "Редактирование сообщения · Enter — сохранить";
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    LinkButton { text: "Отмена"; color: Theme.dim; font-size: 12px; clicked => { root.cancel-edit(); } }
                }
                Rectangle {
                    height: 44px;
                    Rectangle {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 44px;
                        border-radius: 8px;
                        background: Theme.hover;
                        border-width: editing ? 1px : 0px;
                        border-color: Theme.accent;
                        IconButton {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            icon: "M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5a2.5 2.5 0 0 0 5 0V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z";
                            visible: can-write && !editing;
                            clicked => { root.attach(); }
                        }
                        // Ctrl+V с картинкой в буфере: прикрепить её. Иначе — обычная вставка текста
                        FocusScope {
                            x: 42px;
                            width: parent.width - 84px;
                            height: parent.height;
                            capture-key-pressed(event) => {
                                if (event.modifiers.control && (event.text == "v" || event.text == "V" || event.text == "м" || event.text == "М")) {
                                    if (can-write && root.paste-image()) {
                                        return accept;
                                    }
                                }
                                // Tab — подставить первую подсказку @упоминания
                                if (event.text == Key.Tab && mentions.length > 0) {
                                    root.pick-mention(0);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    if (root.emoji-for != -2) { root.emoji-for = -2; return accept; }
                                    if (editing) { root.cancel-edit(); return accept; }
                                    if (reply-to != "") { root.cancel-reply(); return accept; }
                                }
                                // Стрелка вверх в пустом поле — изменить своё последнее сообщение (как в Discord)
                                if (event.text == Key.UpArrow && input.text == "" && !editing) {
                                    root.edit-message(-1);
                                    return accept;
                                }
                                reject
                            }
                            input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                color: Theme.text;
                                vertical-alignment: center;
                                read-only: !can-write;
                                text <=> root.composer-text;
                                edited => {
                                    root.typing();
                                    root.composer-changed(self.text);
                                }
                                accepted => {
                                    if ((self.text != "" || pending-files.length > 0) && can-write) {
                                        root.send(self.text);
                                        root.composer-text = "";
                                        root.composer-changed("");
                                    }
                                }
                            }
                        }
                        if input.text == "": Text {
                            x: 42px;
                            height: parent.height;
                            text: !can-write ? "Выберите текстовый канал" : in-dm ? "Написать @" + channel-name : "Написать в " + (in-thread ? "ветку " : "#") + channel-name;
                            color: Theme.dim;
                            vertical-alignment: center;
                        }
                        IconButton {
                            x: parent.width - 36px;
                            y: (parent.height - self.height) / 2;
                            // Эмодзи
                            icon: "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z";
                            visible: can-write;
                            on: root.emoji-for == -1;
                            clicked => { root.emoji-for = root.emoji-for == -1 ? -2 : -1; }
                        }
                    }
                }
                // «… печатает» — тонкая строка под полем ввода (место зарезервировано, лента не прыгает)
                HorizontalLayout {
                    height: 20px;
                    padding-left: 18px;
                    Text {
                        text: typing-text;
                        color: Theme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---- Участники
        if !screen-full: Rectangle {
            width: 220px;
            background: Theme.bg1;
            Flickable {
                VerticalLayout {
                    padding: 8px;
                    padding-top: 12px;
                    spacing: 2px;
                    alignment: start;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text {
                            height: 28px;
                            text: "УЧАСТНИКИ — " + members.length;
                            color: Theme.dim;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    for u[i] in members: mta := TouchArea {
                        height: 42px;
                        Rectangle {
                            border-radius: 4px;
                            background: mta.has-hover ? Theme.hover : transparent;
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Avatar { size: 32px; initial: u.initial; tint: u.tint; image: u.avatar; has-image: u.has-avatar; }
                            }
                            Text {
                                text: u.name;
                                color: mta.has-hover ? Theme.text : u.tint;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if u.can-message && mta.has-hover: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    // «Написать в личку»
                                    icon: "M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z";
                                    clicked => { root.message-member(i); }
                                }
                            }
                            if u.can-roles && mta.has-hover: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: "M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z";
                                    clicked => { root.member-roles(i); }
                                }
                            }
                            if u.can-kick && mta.has-hover: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    // «Выгнать»: дверь со стрелкой
                                    icon: "M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5a2 2 0 0 0-2 2v4h2V5h14v14H5v-4H3v4a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z";
                                    clicked => { root.kick-member(i); }
                                }
                            }
                            if u.can-ban && mta.has-hover: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    // «Забанить»: перечёркнутый круг
                                    icon: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9A7.902 7.902 0 0 1 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1A7.902 7.902 0 0 1 20 12c0 4.42-3.58 8-8 8z";
                                    on: false;
                                    clicked => { root.ban-member(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Эмодзи: над полем ввода справа
    if emoji-for != -2: EmojiPicker {
        x: main.width - 220px - self.width - 24px;
        y: main.height - self.height - 76px;
        title: emoji-for == -1 ? "ЭМОДЗИ" : "РЕАКЦИЯ";
        pick(e) => { root.emoji-picked(e); }
        close => { root.emoji-for = -2; }
    }

    if dialog == "create": Dialog {
        title: "Новое сообщество";
        hint: "Своё сообщество для клана, гильдии или друзей: каналы, голос, роли.";
        ok-text: "Создать";
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "join": Dialog {
        title: "Вступить в сообщество";
        hint: "Вставьте код приглашения, который вам прислали.";
        ok-text: "Войти";
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "settings": SettingsDialog {
        input-devices: root.input-devices;
        output-devices: root.output-devices;
        input-index <=> root.set-input;
        output-index <=> root.set-output;
        ptt <=> root.set-ptt;
        noise <=> root.set-noise;
        echo <=> root.set-echo;
        economy <=> root.set-economy;
        notify <=> root.set-notify;
        sounds <=> root.set-sounds;
        updates <=> root.set-updates;
        ptt-key: root.ptt-key;
        save => { root.save-settings(); }
        cancel => { root.dialog = ""; }
        configure-ptt => { root.configure-ptt(); }
    }
    if dialog == "channel": Dialog {
        title: "Новый канал";
        hint: "Название канала, например «рейды» или «Лобби».";
        ok-text: "Создать";
        switch-label: "Голосовой канал";
        switch-value <=> root.dialog-switch;
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "thread": Dialog {
        title: "Новая ветка";
        hint: "Обсуждение отдельно от общего чата. Появится в списке каналов под этим каналом.";
        ok-text: "Создать";
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "roles": RolesDialog {
        roles: root.role-items;
        perm-items: root.perm-items;
        role-name <=> root.role-name;
        color-index: root.role-color-index;
        is-everyone: root.role-is-everyone;
        editable: root.role-editable;
        select-role(i) => { root.select-role(i); }
        create-role => { root.create-role(); }
        save-role => { root.save-role(); }
        delete-role => { root.delete-role(); }
        pick-color(i) => { root.pick-role-color(i); }
        close => { root.dialog = ""; }
    }
    if dialog == "member-roles": MemberRolesDialog {
        member-name: root.roles-member-name;
        items: root.member-role-items;
        save => { root.save-member-roles(); }
        close => { root.dialog = ""; }
    }
    if dialog == "kick": Dialog {
        title: "Выгнать участника?";
        hint: "Он сможет вернуться только по новому приглашению.";
        ok-text: "Выгнать";
        read-only: true;
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "ban": Dialog {
        title: "Забанить участника?";
        hint: "Его выгонят, и вернуться по приглашению он не сможет. Разбанить можно в настройках сообщества.";
        ok-text: "Забанить";
        read-only: true;
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "delete": Dialog {
        title: "Удалить сообщение?";
        hint: "Его удалят у всех. Отменить нельзя.";
        ok-text: "Удалить";
        read-only: true;
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = ""; }
    }
    if dialog == "invite": Dialog {
        title: "Пригласить друзей";
        hint: "Отправьте этот код другу. В Feather: кнопка со стрелкой слева → вставить код.";
        read-only: true;
        value <=> root.dialog-value;
        cancel => { root.dialog = ""; }
    }
    if dialog == "info": Dialog {
        title: "Готово";
        hint: root.dialog-switch ? "Передайте пароль пользователю: войти можно только с ним, старые сеансы закрыты." : "";
        read-only: true;
        value <=> root.dialog-value;
        cancel => { root.dialog = ""; }
    }
    if dialog == "confirm-user": Dialog {
        title: "Удалить пользователя?";
        hint: "Аккаунт и все его сообщества будут удалены навсегда. Сообщения в чужих сообществах останутся от «Удалённого аккаунта».";
        ok-text: "Удалить";
        read-only: true;
        value <=> root.dialog-value;
        ok => { root.dialog-ok(); }
        cancel => { root.dialog = "admin"; }
    }
    if dialog == "account": AccountDialog {
        tab <=> root.account-tab;
        username: root.account-username;
        display-name <=> root.account-display-name;
        initial: root.me-initial;
        tint: root.me-tint;
        avatar: root.me-avatar;
        has-avatar: root.me-has-avatar;
        pw-current <=> root.account-pw-current;
        pw-new <=> root.account-pw-new;
        pw-new2 <=> root.account-pw-new2;
        totp-enabled: root.account-totp-enabled;
        totp-setup: root.account-totp-setup;
        totp-qr: root.account-totp-qr;
        totp-secret: root.account-totp-secret;
        totp-code <=> root.account-totp-code;
        confirm-password <=> root.account-confirm-password;
        message: root.account-message;
        message-ok: root.account-message-ok;
        save-profile => { root.account-save-profile(); }
        pick-avatar => { root.account-pick-avatar(); }
        remove-avatar => { root.account-remove-avatar(); }
        change-password => { root.account-change-password(); }
        start-totp => { root.account-start-totp(); }
        enable-totp => { root.account-enable-totp(); }
        disable-totp => { root.account-disable-totp(); }
        delete-account => { root.account-delete(); }
        logout => { root.logout(); }
        close => { root.dialog = ""; }
    }
    if dialog == "guild": GuildSettingsDialog {
        tab <=> root.guild-tab;
        tab-labels: root.guild-tab-labels;
        name <=> root.guild-edit-name;
        can-manage: root.guild-can-manage;
        is-owner: root.guild-is-owner;
        member-names: root.guild-member-names;
        new-owner <=> root.guild-new-owner;
        confirm-name <=> root.guild-confirm-name;
        bans: root.guild-bans;
        audit: root.guild-audit;
        message: root.guild-message;
        message-ok: root.guild-message-ok;
        save-name => { root.guild-save-name(); }
        transfer => { root.guild-transfer(); }
        delete-guild => { root.guild-delete(); }
        leave => { root.guild-leave(); }
        unban(i) => { root.guild-unban(i); }
        close => { root.dialog = ""; }
        changed tab => { root.guild-tab-changed(self.tab); }
    }
    if dialog == "channel-settings": ChannelSettingsDialog {
        name <=> root.ch-name;
        is-voice: root.ch-is-voice;
        is-category: root.ch-is-category;
        private <=> root.ch-private;
        read-only <=> root.ch-read-only;
        roles: root.ch-roles;
        message: root.ch-message;
        save => { root.ch-save(); }
        delete-channel => { root.ch-delete(); }
        close => { root.dialog = ""; }
    }
    if dialog == "admin": AdminDialog {
        registration <=> root.admin-registration;
        users: root.admin-users;
        message: root.admin-message;
        message-ok: root.admin-message-ok;
        set-registration(i) => { root.admin-set-registration(i); }
        reset-password(i) => { root.admin-reset-password(i); }
        delete-user(i) => { root.admin-delete-user(i); }
        close => { root.dialog = ""; }
    }
    if dialog == "screen": ScreenDialog {
        qualities: root.screen-qualities;
        quality <=> root.screen-quality;
        sources: root.screen-sources;
        source <=> root.screen-source;
        start => { root.start-screen(); }
        close => { root.dialog = ""; }
    }
    if dialog == "volume": VolumeDialog {
        name: root.volume-name;
        volume <=> root.volume-value;
        changed(v) => { root.volume-changed(v); }
        close => { root.dialog = ""; }
    }
    if dialog == "list": MessageListDialog {
        title: root.list-title;
        empty-text: root.list-empty;
        rows: root.list-rows;
        query <=> root.search-query;
        searchable: root.list-searchable;
        search => { root.list-search(); }
        open(i) => { root.list-open(i); }
        action(i) => { root.list-action(i); }
        close => { root.dialog = ""; }
    }
}
